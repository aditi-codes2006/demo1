# Copy this file to .env and fill in real values to use live services.
# If left unset, the app runs in dev/test mode:
#   - no MONGODB_URI  -> uses an in-process memory store instead of MongoDB
#   - no OPENAI_API_KEY -> uses a heuristic mock LLM provider instead of OpenAI

PORT=4000
MONGODB_URI=mongodb://localhost:27017/interviewiq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
